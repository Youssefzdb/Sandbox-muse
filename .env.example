# Copy to Vercel Environment Variables (server-side only). Do NOT commit a real .env file.
# Queue mode (recommended, no public bridge needed):
#   Create KV (Upstash Redis) in Vercel Dashboard -> Storage, connect it to this project.
#   Vercel will auto-fill UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN on redeploy.
#   JOB_TOKEN is a password you type in the site UI (stored only in your browser).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JOB_TOKEN=
# Direct bridge mode (old, needs a public tunnel URL, not Vercel's own URL):
BRIDGE_URL=
BRIDGE_API_KEY=
